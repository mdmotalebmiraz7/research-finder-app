{
  "name": "research-finder-desktop",
  "productName": "Research Finder",
  "version": "2.0.0",
  "description": "Research Finder - desktop app",
  "author": "Md Miraz Ali",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.miraz.researchfinder",
    "productName": "Research Finder",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "package.json"],
    "extraResources": [
      { "from": "stage/ui", "to": "ui" },
      { "from": "stage/backend", "to": "backend" }
    ],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "perMachine": false
    }
  }
}
